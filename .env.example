# Copy this file to .env for local use. On Vercel/Render add the same names in the dashboard.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
SECRET_KEY=change-this-to-a-long-random-string
# Cloud only: PostgreSQL connection string (Neon / Supabase / Vercel Postgres). Leave empty locally to use SQLite.
DATABASE_URL=
